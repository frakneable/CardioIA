  {
    "id": "tpl_alerta",
    "type": "ui-template",
    "z": "cardioia_tab",
    "group": "g_alerta",
    "page": "",
    "ui": "",
    "name": "Indicador de alerta",
    "order": 1,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"cardio-alerta\" :class=\"estado\">\n    <span class=\"luz\"></span>\n    <div>\n      <div class=\"titulo\">{{ titulo }}</div>\n      <div class=\"detalhe\">{{ detalhe }}</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    p () { return this.msg?.payload },\n    estado () { return !this.p ? 'aguardando' : (this.p.ativo ? 'em-alerta' : 'normal') },\n    titulo () {\n      if (!this.p) return 'Aguardando dados do vestível...'\n      return this.p.ativo ? 'ALERTA: ' + this.p.motivo.replaceAll(' ', ' + ') : 'Sinais normais'\n    },\n    detalhe () {\n      if (!this.p) return 'Nenhuma leitura recebida ainda'\n      const bpm = this.p.bpm > 0 ? this.p.bpm + ' BPM' : 'sem leitura de pulso'\n      const hora = this.p.ts ? new Date(this.p.ts * 1000).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : ''\n      return `${bpm} · ${this.p.temp} °C · ${hora}`\n    }\n  }\n}\n</script>\n\n<style scoped>\n.cardio-alerta { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border-radius: 8px; color: #fff; font-family: Helvetica, Arial, sans-serif; }\n.cardio-alerta.normal { background: #1a7f37; }\n.cardio-alerta.em-alerta { background: #b42318; }\n.cardio-alerta.aguardando { background: #6e7781; }\n.luz { width: 22px; height: 22px; border-radius: 50%; background: #fff; flex: none; }\n.em-alerta .luz { animation: pisca 0.8s infinite; }\n@keyframes pisca { 50% { opacity: 0.2; } }\n.titulo { font-size: 22px; font-weight: 700; text-transform: none; }\n.detalhe { font-size: 14px; opacity: 0.9; margin-top: 2px; }\n</style>",
    "storeOutMessages": true,
