  {
    "id": "f_separa",
    "type": "function",
    "z": "cardioia_tab",
    "name": "Separa sinais",
    "func": "// Recebe uma leitura do ESP32 e distribui para os widgets.\n// ts vem em segundos (NTP); 0 = ESP32 ainda sem horário -> usa o de chegada.\nconst v = msg.payload;\nconst quando = v.ts > 1700000000 ? v.ts * 1000 : Date.now();\n\n// Descarta repetidos (o ESP32 pode reenviar a fila após reiniciar)\nconst vistos = context.get('vistos') || [];\nconst chave = `${v.ts}-${v.seq}`;\nif (vistos.includes(chave)) return null;\nvistos.push(chave);\ncontext.set('vistos', vistos.slice(-200));\n\nconst bpm = v.bpm > 0\n    ? [{ topic: 'BPM', payload: { x: quando, y: v.bpm } },\n       { topic: 'Limite em repouso (120)', payload: { x: quando, y: 120 } }]\n    : null;   // sem leitura de pulso: não desenha ponto\nconst temperatura = { topic: 'Temperatura (°C)', payload: { x: quando, y: v.temp } };\nconst gauge = { payload: v.temp };\nconst alerta = { payload: { ativo: v.alerta === 1, motivo: v.motivo, bpm: v.bpm, temp: v.temp, ts: quando / 1000 } };\nconst hora = new Date(quando).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst movimento = { payload: `${v.mov} (${v.acel.toFixed(2)} g) · leitura #${v.seq} às ${hora}` };\n\nreturn [bpm, temperatura, gauge, alerta, movimento];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 120,
    "wires": [
      [
        "ch_bpm"
      ],
      [
        "ch_temp"
      ],
      [
        "gauge_temp"
      ],
      [
        "tpl_alerta"
      ],
      [
        "txt_mov"
      ]
    ],
    "outputLabels": [
      "gráfico BPM",
      "gráfico temperatura",
      "gauge",
      "alerta",
      "movimento"
    ]
  },
